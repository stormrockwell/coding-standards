{
	"name": "@digitalimpulse/coding-standards",
	"version": "1.0.0",
	"description": "Shared ESLint, Stylelint, Prettier, and TypeScript configs for DemandDrive projects.",
	"repository": "git@github.com:digitalimpulse/coding-standards.git",
	"license": "GPL-2.0",
	"author": "DemandDrive Team <dev@demanddrive.com>",
	"private": false,
	"files": [
		"eslint",
		"stylelint",
		"prettier",
		"tsconfig",
		"editorconfig"
	],
	"exports": {
		"./eslint": "./eslint/index.js",
		"./eslint/base": "./eslint/base.js",
		"./eslint/wordpress": "./eslint/wordpress.js",
		"./stylelint": "./stylelint/index.cjs",
		"./stylelint/base": "./stylelint/base.cjs",
		"./stylelint/wordpress": "./stylelint/wordpress.cjs",
		"./prettier": "./prettier/index.js",
		"./tsconfig/base.json": "./tsconfig/base.json"
	},
	"peerDependencies": {
		"@eslint/js": ">=9",
		"@typescript-eslint/eslint-plugin": ">=8",
		"@typescript-eslint/parser": ">=8",
		"@wordpress/eslint-plugin": ">=25",
		"@wordpress/stylelint-config": ">=20",
		"eslint": ">=9",
		"eslint-import-resolver-typescript": ">=3",
		"globals": ">=13",
		"prettier": ">=3",
		"stylelint": ">=14",
		"stylelint-config-recommended-scss": ">=5",
		"stylelint-order": ">=6",
		"stylelint-semantic-groups": ">=1",
		"typescript": ">=4.9"
	},
	"peerDependenciesMeta": {
		"@wordpress/eslint-plugin": {
			"optional": true
		},
		"@wordpress/stylelint-config": {
			"optional": true
		},
		"eslint-import-resolver-typescript": {
			"optional": true
		},
		"prettier": {
			"optional": true
		}
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"@wordpress/eslint-plugin": "^28.1.0",
		"@wordpress/stylelint-config": "^22.7.0",
		"eslint": "^9.39.5",
		"eslint-import-resolver-typescript": "^4.4.5",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"stylelint": "^14.16.1",
		"stylelint-config-recommended-scss": "^5.0.2",
		"stylelint-order": "^6.0.4",
		"stylelint-semantic-groups": "^1.2.2",
		"typescript": "^6.0.3"
	},
	"scripts": {
		"lint:fixtures": "npm run lint:fixtures:base && npm run lint:fixtures:wordpress",
		"lint:fixtures:base": "cd fixtures/node-site && eslint . && stylelint \"**/*.scss\"",
		"lint:fixtures:wordpress": "cd fixtures/wordpress-plugin && eslint . && stylelint \"**/*.scss\""
	}
}
